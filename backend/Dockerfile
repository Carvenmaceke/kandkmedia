# Multi-stage build: compile with Maven+JDK, run with a slim JRE only.
FROM eclipse-temurin:17-jdk-jammy AS build
WORKDIR /app
COPY pom.xml .
COPY src ./src
RUN apt-get update && apt-get install -y maven --no-install-recommends \
    && mvn -B -q clean package -DskipTests \
    && rm -rf /var/lib/apt/lists/*

FROM eclipse-temurin:17-jre-jammy
WORKDIR /app

# Payslips are generated by filling the real company .docx template and
# converting it to PDF via headless LibreOffice (writer-only — no calc/
# impress/draw — to keep the image reasonably sized) rather than
# hand-drawing a PDF approximation of it.
#
# libreoffice-writer pulls in NO font package at all (checked via `apt-cache
# depends` — not even as a Recommends/Suggests), and this base image starts
# with none either, so without a font package the container has no usable
# Latin font at all. fonts-liberation is installed for that base coverage;
# fonts-dejavu-core is kept alongside it as a broader-Unicode fallback for
# any glyph Liberation Sans doesn't cover.
#
# The template's own font, "Microsoft Sans Serif", is Windows-only and has
# no Linux equivalent, so some substitution is unavoidable — but fontconfig's
# default pick for it (DejaVu Sans) is measurably wider, wide enough that
# several of the template's tightly laid-out label boxes (e.g. the "Amount"
# / "Opening Balance" column headers) visibly overlapped when rendered.
# docker/fontconfig/51-microsoft-sans-serif.conf forces the substitution to
# Liberation Sans instead — verified, by auditing every static label's text
# width against its box width, to fit the whole template with a positive
# margin where DejaVu Sans did not.
RUN apt-get update && apt-get install -y --no-install-recommends libreoffice-writer fonts-liberation fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
COPY docker/fontconfig/51-microsoft-sans-serif.conf /etc/fonts/conf.d/51-microsoft-sans-serif.conf

COPY --from=build /app/target/*.jar app.jar

# Render (and most hosts) set PORT at runtime; Spring reads server.port from
# it via application.yml's ${PORT:8080} — see below.
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
